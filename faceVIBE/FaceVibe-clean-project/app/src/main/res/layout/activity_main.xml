<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- hidden diagnostics panel (tap the picture to show/hide) -->
    <com.facevibe.app.DiagView
        android:id="@+id/diag"
        android:layout_width="210dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="150dp"
        android:visibility="gone" />

    <!-- joke card, upper left: tap for the punchline -->
    <LinearLayout
        android:id="@+id/jokeCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_joke_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/jokeSetup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="170dp"
            android:text="Why can't you trust an atom?"
            android:textColor="#1B1B1F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/jokePunch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxWidth="170dp"
            android:textColor="#C62828"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/jokeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="tap for the punchline"
            android:textColor="#77777F"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- emoji card, upper right -->
    <TextView
        android:id="@+id/emoji"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_emoji_card"
        android:elevation="6dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="🙂"
        android:textSize="46sp" />

    <!-- LIVE / status pill, bottom left -->
    <LinearLayout
        android:id="@+id/statusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_pill"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="260dp"
            android:text="Starting…"
            android:textColor="#1B1B1F"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
