<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- hidden diagnostics panel (tap the picture to show/hide) -->
    <com.facevibe.app.DiagView
        android:id="@+id/diag"
        android:layout_width="210dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="150dp"
        android:visibility="gone" />

    <!-- emoji card, upper right -->
    <TextView
        android:id="@+id/emoji"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_emoji_card"
        android:elevation="6dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="🙂"
        android:textSize="46sp" />

    <ImageView
        android:id="@+id/emojiImg"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:elevation="7dp"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- the two labels of the matched emoji, upper left -->
    <TextView
        android:id="@+id/emojiLabels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_pill"
        android:elevation="6dp"
        android:gravity="start"
        android:maxWidth="250dp"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text=""
        android:textColor="#1B1B1F"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- LIVE / status pill, bottom left -->
    <LinearLayout
        android:id="@+id/statusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_pill"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="260dp"
            android:text="Starting…"
            android:textColor="#1B1B1F"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/shareBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="112dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_pill"
        android:elevation="4dp"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:text="Share"
        android:textColor="#1B1B1F"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/speedBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="92dp"
        android:background="@drawable/bg_pill"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Steady"
            android:textColor="#1B1B1F"
            android:textSize="12sp" />
        <SeekBar
            android:id="@+id/speed"
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:max="4"
            android:progress="2" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fast"
            android:textColor="#1B1B1F"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/teachBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_pill"
        android:elevation="4dp"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:text="Teach"
        android:textColor="#1B1B1F"
        android:textSize="15sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/teach"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="10dp"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp">
                <ImageView
                    android:id="@+id/tImg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />
                <TextView
                    android:id="@+id/tChar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textSize="64sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#6B6B76"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#1B1B1F"
                    android:textSize="26sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#3A3A44"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="10dp"
            android:background="@drawable/bg_pill"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:id="@+id/tStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#1B1B1F"
                android:textSize="20sp"
                android:textStyle="bold" />
            <ProgressBar
                android:id="@+id/tProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:max="100" />
            <Button android:id="@+id/bNew" style="?android:attr/buttonBarButtonStyle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="+ Add your own emoji" android:textSize="14sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/bBack" style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:minWidth="0dp" android:padding="2dp" android:text="◀ Back" android:textSize="13sp" />
                <Button android:id="@+id/bSkip" style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:minWidth="0dp" android:padding="2dp" android:text="Skip ▶" android:textSize="13sp" />
                <Button android:id="@+id/bAdd" style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:minWidth="0dp" android:padding="2dp" android:text="+ Sample" android:textSize="13sp" />
                <Button android:id="@+id/bPause" style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:minWidth="0dp" android:padding="2dp" android:text="Pause" android:textSize="13sp" />
                <Button android:id="@+id/bFinish" style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:minWidth="0dp" android:padding="2dp" android:text="Finish" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <ImageView
        android:id="@+id/frozen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp"
        android:scaleType="fitXY"
        android:visibility="gone" />
</FrameLayout>
